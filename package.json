{
  "name": "jobpilot-ai",
  "version": "1.0.0",
  "description": "Autonomous 24/7 AI Job Search, Application & Career Intelligence Platform",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node server/index.js",
    "start:dist": "node dist/index.js",
    "dev": "node server/index.js",
    "scout": "npx tsx agent-scout.ts",
    "scout:watch": "npx tsx agent-scout.ts --watch",
    "apply": "npx tsx src/scripts/apply_pilot.ts",
    "apply:pilot": "npx tsx src/scripts/apply_pilot.ts",
    "apply:local": "npx tsx src/scripts/run_local_persistent_apply.ts",
    "leads:local": "npx tsx src/scripts/local_business_leadgen.ts",
    "deploy:pm2": "npx pm2 start ecosystem.config.js",
    "deploy:stop": "npx pm2 stop ecosystem.config.js",
    "deploy:status": "npx pm2 status",
    "legacy": "python start_all.py",
    "test": "node --test tests/autonomous_pipeline.test.js",
    "test:legacy": "python -m unittest tests/test_agents.py"
  },
  "keywords": [
    "ai",
    "job-search",
    "career-agent",
    "playwright",
    "resume-builder",
    "salary-intelligence"
  ],
  "author": "Kiran S R",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "bullmq": "^6.3.10",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "googleapis": "^140.0.0",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.10.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.2.1",
    "openai": "^7.25.0",
    "redis": "^6.3.0",
    "winston": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "playwright": "^1.63.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
