# Automation & Safeguard Configuration
AUTO_APPLY_ENABLED=true
MAX_DAILY_APPLICATIONS=50
SAFEGUARD_CAPTCHA_PAUSE=false

# Log & Debug Levels
LOG_LEVEL=INFO
