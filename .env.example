# JobPilot AI Platform Environment Configuration

# Service Ports
PORT=3000
NODE_PORT=3000
FASTAPI_PORT=8000
FASTAPI_URL=http://localhost:8000
DATABASE_URL=sqlite:///./jobpilot.db

# Freelance & Paid Gig Platform API Keys & MCP Integration
UPWORK_API_KEY=your_upwork_api_key_here
FREELANCER_API_KEY=your_freelancer_com_api_key_here
FIVERR_CLIENT_ID=your_fiverr_client_id_here
WELLFOUND_API_KEY=your_wellfound_angellist_api_key_here

# LLM & AI Engine API Keys
GROK_API_KEY=your_grok_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
